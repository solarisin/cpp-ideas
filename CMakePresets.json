{
    "version": 8,
    "configurePresets": [
        {
            "name": "linux-x64",
            "hidden": true,
            "displayName": "",
            "description": "",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "installDir": "${sourceDir}/install/${presetName}",
            "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
            "environment": {
                "VCPKG_DEFAULT_BINARY_CACHE": "/bincache",
                "X_VCPKG_ASSET_SOURCES": "clear;x-azurl,file:///assetcache,,readwrite"
            },
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_CXX_STANDARD": "23",
                "CMAKE_C_STANDARD": "17",
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/install/${presetName}",
                "VCPKG_MANIFEST_DIR": "${sourceDir}/.vcpkg",
                "VCPKG_INSTALLED_DIR": "${sourceDir}/.vcpkg/installed",
                "VCPKG_MANIFEST_INSTALL": "ON",
                "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/.vcpkg/triplets",
                "CMAKE_CXX_COMPILER_LAUNCHER": "ccache",
                "CMAKE_CXX_COMPILER": "/usr/bin/clang++"
            }
        },
        {
            "name": "linux-x64-static",
            "hidden": true,
            "inherits": "linux-x64",
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "x64-linux-static",
                "VCPKG_INSTALL_OPTIONS": "--host-triplet=x64-linux-static"
            }
        },
        {
            "name": "linux-x64-dynamic",
            "hidden": true,
